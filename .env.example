# QuantLab configuration. Copy to .env and fill in. NEVER commit .env.
# Every variable is optional; features that need a missing key report "not configured".

# --- Storage -----------------------------------------------------------------
# Root for the market-data store, research registry and generated reports.
QUANTLAB_DATA_DIR=./data

# --- Free data providers -----------------------------------------------------
# FRED / ALFRED (rates, VIX, macro vintages). Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Tiingo EOD prices (free tier, includes some delisted tickers). https://www.tiingo.com
TIINGO_API_KEY=
# SEC EDGAR requires a contact string in the User-Agent (fair-access policy).
EDGAR_USER_AGENT="QuantLab research your-email@example.com"

# --- Paid data providers (optional, later) -------------------------------------
# Historical options (EOD bid/ask, IV, Greeks)
ORATS_API_KEY=
# Intraday bars/quotes and options aggregates
POLYGON_API_KEY=
# Survivorship-free equities / index membership are delivered as local files by Norgate;
# point this at the export directory if you buy it.
NORGATE_EXPORT_DIR=

# --- Research defaults -------------------------------------------------------
# Minutes after the official close before daily bars are treated as available.
QUANTLAB_BAR_PUBLICATION_DELAY_MIN=15
# Default seed for anything stochastic (bootstrap, permutation, Monte Carlo).
QUANTLAB_DEFAULT_SEED=20260927

# --- Execution safety --------------------------------------------------------
# Real-money execution is NOT implemented. Even when it is, it will require BOTH this flag
# AND a signed safety-review file (see RISK_MANAGEMENT.md). Leave false.
QUANTLAB_LIVE_TRADING_ENABLED=false
QUANTLAB_LIVE_SAFETY_REVIEW_FILE=
